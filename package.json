{
  "name": "@ngandu-dev/database-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --filter '*' build",
    "check:package": "bun run --filter '*' check:package",
    "format": "biome check --write .",
    "format:check": "biome check .",
    "lint": "biome lint .",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter '*' test",
    "test:coverage": "bun run --filter '*' test:coverage",
    "quality": "bun run format:check && bun run lint && bun run typecheck && bun run test && bun run build && bun run check:package",
    "version": "changeset version",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@biomejs/biome": "^2.4.7",
    "@changesets/cli": "^2.30.0",
    "@types/bun": "latest",
    "@types/mssql": "^9.1.9",
    "@types/node": "^25.5.0",
    "@types/pg": "^8.18.0",
    "@types/semver": "^7.7.1",
    "@types/sqlite3": "^5.1.0",
    "@vitest/coverage-v8": "^4.1.0",
    "mssql": "^12.2.0",
    "mysql2": "^3.20.0",
    "pg": "^8.20.0",
    "publint": "^0.3.17",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
