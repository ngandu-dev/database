{
  "name": "@ngandu-dev/database-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --filter '*' build",
    "check:package": "bun run --filter '*' check:package",
    "format": "biome check --write .",
    "format:check": "biome check .",
    "lint": "biome lint .",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter '*' test",
    "test:coverage": "bun run --filter '*' test:coverage",
    "quality": "bun run format:check && bun run lint && bun run typecheck && bun run test && bun run build && bun run check:package",
    "version": "changeset version",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.5.9",
    "@changesets/cli": "^3.0.1",
    "@types/bun": "^1.3.14",
    "@types/mssql": "^12.3.0",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "@types/semver": "^7.8.0",
    "@types/sqlite3": "^5.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "mssql": "^12.7.0",
    "mysql2": "^3.23.3",
    "pg": "^8.23.0",
    "publint": "^0.3.24",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "esbuild": "0.28.1"
  }
}
