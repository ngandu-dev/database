{
  "name": "@devscast/queryforge",
  "version": "1.0.0",
  "type": "module",
  "source": "./src/index.ts",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "bin": {
    "sql-forge": "./dist/sql-forge.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.4.2",
    "@changesets/cli": "^2.29.8",
    "@commitlint/cli": "^20.4.1",
    "@commitlint/config-conventional": "^20.4.1",
    "@types/bun": "latest",
    "@types/node": "^25.3.1",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "@vitest/coverage-v8": "^4.0.18",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "husky": "^9.1.7",
    "tsup": "^8.5.1",
    "vitest": "^4.0.18"
  },
  "scripts": {
    "build": "tsup --minify",
    "dev": "tsup --watch",
    "sql-forge": "bun run build && bun run dist/sql-forge.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "============= HUSKY =============": "",
    "prepare": "husky",
    "commit": "cz",
    "=========== CODE STYLE ============": "",
    "lint": "biome check && biome lint",
    "format": "biome format --write && biome check --write && biome lint --write",
    "typecheck": "tsc --noEmit",
    "=========== NPM PUBLISH ==============": "",
    "release": "npm run build && npm publish --access public",
    "version": "changeset version"
  },
  "lint-staged": {
    "*.ts": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "author": "Bernard Ngandu <bernard@devscast.tech>",
  "license": "MIT",
  "description": "QueryForge : Raw SQL into something clean.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devscast/queryforge-ts.git"
  },
  "bugs": {
    "url": "https://github.com/devscast/queryforge-ts/issues"
  },
  "homepage": "https://github.com/devscast/queryforge-ts#readme"
}
