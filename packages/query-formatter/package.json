{
  "name": "@ngandu-dev/query-formatter",
  "version": "2.0.0",
  "description": "Format, compress, and highlight SQL in TypeScript and Node.js.",
  "license": "MIT",
  "author": "Bernard Ngandu <bernard@ngandu.dev>",
  "type": "module",
  "sideEffects": false,
  "source": "./src/index.ts",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "sql-forge": "./dist/sql-forge.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup --minify",
    "dev": "tsup --watch",
    "format": "biome check --write src",
    "lint": "biome lint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check:package": "publint && attw --pack . --profile node16",
    "sql-forge": "bun run build && bun run dist/sql-forge.js"
  },
  "keywords": [
    "sql",
    "formatter",
    "highlight",
    "database"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ngandu-dev/database.git",
    "directory": "packages/query-formatter"
  },
  "bugs": {
    "url": "https://github.com/ngandu-dev/database/issues"
  },
  "homepage": "https://github.com/ngandu-dev/database/tree/main/packages/query-formatter#readme",
  "publishConfig": {
    "access": "public"
  }
}
