{
  "name": "@ngandu-dev/database",
  "version": "2.0.0",
  "description": "A TypeScript database abstraction layer inspired by Doctrine DBAL.",
  "license": "MIT",
  "author": "Bernard Ngandu <bernard@ngandu.dev>",
  "type": "module",
  "sideEffects": false,
  "source": "./src/_index.ts",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./connections": {
      "import": {
        "types": "./dist/connections.d.ts",
        "default": "./dist/connections.js"
      },
      "require": {
        "types": "./dist/connections.d.cts",
        "default": "./dist/connections.cjs"
      }
    },
    "./driver": {
      "import": {
        "types": "./dist/driver.d.ts",
        "default": "./dist/driver.js"
      },
      "require": {
        "types": "./dist/driver.d.cts",
        "default": "./dist/driver.cjs"
      }
    },
    "./exception": {
      "import": {
        "types": "./dist/exception.d.ts",
        "default": "./dist/exception.js"
      },
      "require": {
        "types": "./dist/exception.d.cts",
        "default": "./dist/exception.cjs"
      }
    },
    "./logging": {
      "import": {
        "types": "./dist/logging.d.ts",
        "default": "./dist/logging.js"
      },
      "require": {
        "types": "./dist/logging.d.cts",
        "default": "./dist/logging.cjs"
      }
    },
    "./platforms": {
      "import": {
        "types": "./dist/platforms.d.ts",
        "default": "./dist/platforms.js"
      },
      "require": {
        "types": "./dist/platforms.d.cts",
        "default": "./dist/platforms.cjs"
      }
    },
    "./portability": {
      "import": {
        "types": "./dist/portability.d.ts",
        "default": "./dist/portability.js"
      },
      "require": {
        "types": "./dist/portability.d.cts",
        "default": "./dist/portability.cjs"
      }
    },
    "./query": {
      "import": {
        "types": "./dist/query.d.ts",
        "default": "./dist/query.js"
      },
      "require": {
        "types": "./dist/query.d.cts",
        "default": "./dist/query.cjs"
      }
    },
    "./tools": {
      "import": {
        "types": "./dist/tools.d.ts",
        "default": "./dist/tools.js"
      },
      "require": {
        "types": "./dist/tools.d.cts",
        "default": "./dist/tools.cjs"
      }
    },
    "./types": {
      "import": {
        "types": "./dist/types.d.ts",
        "default": "./dist/types.js"
      },
      "require": {
        "types": "./dist/types.d.cts",
        "default": "./dist/types.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup --minify",
    "dev": "tsup --watch",
    "format": "biome check --write src scripts",
    "lint": "biome lint src scripts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.unit.config.ts",
    "test:all": "vitest run",
    "test:coverage": "vitest run --config vitest.unit.config.ts --coverage",
    "test:functional": "bun scripts/test-functional.mjs",
    "test:functional:local": "bun scripts/test-functional-local.mjs",
    "check:package": "publint && attw --pack . --profile node16"
  },
  "keywords": [
    "database",
    "dbal",
    "sql",
    "mysql",
    "postgresql",
    "sqlite",
    "sql-server"
  ],
  "dependencies": {
    "@ngandu-dev/query-builder": "^2.0.0",
    "semver": "^7.7.4"
  },
  "peerDependencies": {
    "mssql": "^12.2.0",
    "mysql2": "^3.17.2",
    "pg": "^8.11.5",
    "sqlite3": "^6.0.1"
  },
  "peerDependenciesMeta": {
    "mssql": {
      "optional": true
    },
    "mysql2": {
      "optional": true
    },
    "pg": {
      "optional": true
    },
    "sqlite3": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ngandu-dev/database.git",
    "directory": "packages/database"
  },
  "bugs": {
    "url": "https://github.com/ngandu-dev/database/issues"
  },
  "homepage": "https://github.com/ngandu-dev/database/tree/main/packages/database#readme",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
